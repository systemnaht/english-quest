{
  "redirects": [
    {"source": "/install.html", "destination": "/", "permanent": false},
    {"source": "/stormspeak/install.html", "destination": "/stormspeak/", "permanent": false}
  ],
  "headers": [
    {"source": "/manifest.webmanifest", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/app.webmanifest", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/icon-192.png", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/icon-512.png", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/app-icon-192.png", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/app-icon-512.png", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/stormspeak/manifest.webmanifest", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/stormspeak/app.webmanifest", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/stormspeak/icon-192.png", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/stormspeak/icon-512.png", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/stormspeak/app-icon-192.png", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/stormspeak/app-icon-512.png", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]}
  ]
}
